NEXT_PUBLIC_APP_NAME=FieldMeasure

# Street map style URL. Empty uses OpenFreeMap (no key needed). "none" disables
# network maps entirely, leaving only the plain built-in view.
NEXT_PUBLIC_MAP_STYLE_URL=

# Satellite style URL from a licensed provider. Without it, no satellite option
# appears. "{key}" is replaced by NEXT_PUBLIC_MAP_API_KEY.
# Example (MapTiler): https://api.maptiler.com/maps/hybrid/style.json?key={key}
NEXT_PUBLIC_SATELLITE_STYLE_URL=

# Public, browser-visible token. Restrict it to your domain in the provider's dashboard.
NEXT_PUBLIC_MAP_API_KEY=

# Set to "true" only if your imagery provider's terms allow satellite imagery in
# downloaded images. Otherwise reports use the street map or a plain background.
NEXT_PUBLIC_SATELLITE_ALLOW_EXPORT=false
